{
  "name": "yt-downloader",
  "productName": "YT Downloader",
  "version": "1.0.0",
  "description": "App desktop para baixar vídeos do YouTube usando yt-dlp",
  "main": "src/main/main.js",
  "author": "RyqR",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "fetch-bin": "node scripts/fetch-binaries.js",
    "fetch-bin:force": "node scripts/fetch-binaries.js --force",
    "dist": "node scripts/fetch-binaries.js && electron-builder --win --x64",
    "dist:portable": "node scripts/fetch-binaries.js && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.ryqr.ytdownloader",
    "productName": "YT Downloader",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "YT Downloader"
    },
    "portable": {
      "artifactName": "YT-Downloader-Portable-${version}.exe"
    }
  }
}
